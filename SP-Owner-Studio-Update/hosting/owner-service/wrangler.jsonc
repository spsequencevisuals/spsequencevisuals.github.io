{
  "name": "sp-sequence-owner-studio",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://spsequencevisuals.github.io",
    "OWNER_GITHUB_LOGIN": "spsequencevisuals",
    "OWNER_GITHUB_ID": "355808109",
    "GITHUB_CLIENT_ID": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sp-sequence-studio",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "sp-sequence-private-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
